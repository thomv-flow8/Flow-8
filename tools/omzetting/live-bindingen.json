  "faqs": [
    {
      "q": "Werkt Flow8 op de telefoon van mijn monteurs?",
      "a": "Ja. Flow8 draait in de browser, dus op elke telefoon of tablet — Android en iPhone. Geen app-store, geen installatie: inloggen en beginnen.",
      "expanded": "true",
      "rows": "1fr",
      "rot": "180deg",
      "bd": "rgba(79,110,245,.34)",
      "sh": "0 14px 34px rgba(20,26,60,.08)",
      "iconBg": "var(--acc)",
      "iconFg": "#fff"
    },
    {
      "q": "Kan ik mijn huidige klantenbestand meenemen?",
      "a": "Ja, via Excel. Klanten, medewerkers, installaties en materialen importeren we in één keer. Je mag aanleveren in je eigen format; wij zetten het om.",
      "expanded": "false",
      "rows": "0fr",
      "rot": "0deg",
      "bd": "#e2e5ec",
      "sh": "none",
      "iconBg": "rgba(79,110,245,.1)",
      "iconFg": "var(--acc)"
    },
    {
      "q": "Zijn er koppelingen met mijn boekhouding?",
      "a": "Nog niet. Vandaag werkt Flow8 met import en export via Excel. Koppelingen met boekhoudpakketten staan op de planning — we bouwen ze op volgorde van wat klanten daadwerkelijk gebruiken.",
      "expanded": "false",
      "rows": "0fr",
      "rot": "0deg",
      "bd": "#e2e5ec",
      "sh": "none",
      "iconBg": "rgba(79,110,245,.1)",
      "iconFg": "var(--acc)"
    },
    {
      "q": "Hoe lang duurt het voor we live zijn?",
      "a": "Meestal twee weken: intake en inrichting in week één, gegevens importeren en live in week twee. De eerste week draaien we met je mee.",
      "expanded": "false",
      "rows": "0fr",
      "rot": "0deg",
      "bd": "#e2e5ec",
      "sh": "none",
      "iconBg": "rgba(79,110,245,.1)",
      "iconFg": "var(--acc)"
    },
    {
      "q": "Wat gebeurt er met een werkbon als de monteur geen bereik heeft?",
      "a": "De bon blijft op zijn toestel staan en gaat door zodra er weer verbinding is. Hij hoeft niets over te typen.",
      "expanded": "false",
      "rows": "0fr",
      "rot": "0deg",
      "bd": "#e2e5ec",
      "sh": "none",
      "iconBg": "rgba(79,110,245,.1)",
      "iconFg": "var(--acc)"
    },
    {
      "q": "Waar staan mijn gegevens?",
      "a": "Op servers binnen de Europese Unie, met dagelijkse back-ups. Je gegevens blijven van jou: je kunt ze op elk moment exporteren, en bij opzeggen krijg je een volledige export mee.",
      "expanded": "false",
      "rows": "0fr",
      "rot": "0deg",
      "bd": "#e2e5ec",
      "sh": "none",
      "iconBg": "rgba(79,110,245,.1)",
      "iconFg": "var(--acc)"
    },
    {
      "q": "Zit ik ergens aan vast?",
      "a": "Nee. Maandelijks opzegbaar, en de eerste drie maanden draai je zonder kosten mee. Je gegevens blijven van jou en kun je altijd exporteren.",
      "expanded": "false",
      "rows": "0fr",
      "rot": "0deg",
      "bd": "#e2e5ec",
      "sh": "none",
      "iconBg": "rgba(79,110,245,.1)",
      "iconFg": "var(--acc)"
    }
